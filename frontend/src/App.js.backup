import React, { useState, useEffect } from 'react';
import ChatInterface from './components/ChatInterface';
import DesignCanvas from './components/DesignCanvas';
import DesignSteps from './components/DesignSteps';
import { MessageCircle, Palette, Layers } from 'lucide-react';

function App() {
  const [activeTab, setActiveTab] = useState('chat');
  const [currentPlan, setCurrentPlan] = useState(null);
  const [messages, setMessages] = useState([]);
  const [isLoading, setIsLoading] = useState(false);

  const tabs = [
    { id: 'chat', label: 'Чат', icon: MessageCircle },
    { id: 'design', label: 'Дизайн', icon: Palette },
    { id: 'steps', label: 'Этапы', icon: Layers }
  ];

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <header className="bg-white shadow-sm border-b border-gray-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-16">
            <div className="flex items-center">
              <h1 className="text-xl font-bold text-gray-900">AI Designer</h1>
            </div>
            <div className="flex items-center space-x-4">
              <span className="text-sm text-gray-500">Генератор дизайна веб-страниц</span>
            </div>
          </div>
        </div>
      </header>

      {/* Navigation Tabs */}
      <nav className="bg-white border-b border-gray-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex space-x-8">
            {tabs.map((tab) => {
              const Icon = tab.icon;
              return (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center space-x-2 py-4 px-1 border-b-2 font-medium text-sm ${
                    activeTab === tab.id
                      ? 'border-blue-500 text-blue-600'
                      : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'
                  }`}
                >
                  <Icon size={20} />
                  <span>{tab.label}</span>
                </button>
              );
            })}
          </div>
        </div>
      </nav>

      {/* Main Content */}
      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {activeTab === 'chat' && (
          <ChatInterface
            messages={messages}
            setMessages={setMessages}
            isLoading={isLoading}
            setIsLoading={setIsLoading}
            setCurrentPlan={setCurrentPlan}
          />
        )}
        
        {activeTab === 'design' && (
          <DesignCanvas
            currentPlan={currentPlan}
            messages={messages}
            setMessages={setMessages}
            isLoading={isLoading}
            setIsLoading={setIsLoading}
          />
        )}
        
        {activeTab === 'steps' && (
          <DesignSteps
            currentPlan={currentPlan}
            setCurrentPlan={setCurrentPlan}
            messages={messages}
            setMessages={setMessages}
            isLoading={isLoading}
            setIsLoading={setIsLoading}
          />
        )}
      </main>
    </div>
  );
}

export default App; 